{
  "//": [
    "Realtime Database 보안 규칙",
    "",
    "쓰는 법",
    "  1) 파이어베이스 콘솔 → Realtime Database → 규칙 탭",
    "  2) 아래 내용을 통째로 붙여넣기",
    "  3) 'ADMIN_UID_HERE' 를 담당자 계정의 UID 로 바꾸기",
    "     (Authentication → 사용자 목록에서 복사)",
    "  4) 게시",
    "",
    "원칙",
    "  · 사진은 누구나 볼 수 있고, 담당자만 올리고 지울 수 있습니다.",
    "  · 질문은 누구나 남길 수 있지만, 한 번 남기면 본인도 고칠 수 없습니다.",
    "  · 답변과 삭제는 담당자만 합니다.",
    "  · 글자 수와 사진 용량을 규칙에서 직접 막아 용량 폭주를 방지합니다."
  ],

  "rules": {
    ".read": false,
    ".write": false,

    "photos": {
      "$kind": {
        ".read": true,
        ".validate": "$kind === 'hall' || $kind === 'memorial'",

        "$no": {
          ".write": "auth != null && auth.uid === 'ADMIN_UID_HERE'",
          ".validate": "$no.matches(/^[0-9]{1,3}$/) && newData.hasChildren(['data'])",

          "data": {
            ".validate": "newData.isString() && newData.val().length <= 60000 && newData.val().beginsWith('data:image/')"
          },
          "by": { ".validate": "newData.isString()" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "qna": {
      ".read": true,

      "$id": {
        ".write": "auth != null && auth.uid === 'ADMIN_UID_HERE' || (!data.exists() && newData.exists())",

        ".validate": "newData.hasChildren(['body', 'at'])",

        "name":  { ".validate": "newData.isString() && newData.val().length <= 20" },
        "body":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000" },
        "at":    { ".validate": "newData.isNumber()" },

        "answer": {
          ".write": "auth != null && auth.uid === 'ADMIN_UID_HERE'",
          ".validate": "newData.isString() && newData.val().length <= 2000 || newData.val() === null"
        },
        "answeredAt": {
          ".write": "auth != null && auth.uid === 'ADMIN_UID_HERE'",
          ".validate": "newData.isNumber()"
        },

        "$other": { ".validate": false }
      }
    }
  }
}
