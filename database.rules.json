{
  "rules": {
    ".read": false,
    ".write": false,

    "photos": {
      "$kind": {
        ".read": true,
        ".validate": "$kind === 'hall' || $kind === 'memorial'",

        "$no": {
          ".write": "auth != null && auth.uid === 'CGaaFhrs59RrtNai2rYEBtdkbDD3'",
          ".validate": "$no.matches(/^[0-9]{1,3}$/)",

          "data": {
            ".validate": "newData.isString() && newData.val().length <= 60000 && newData.val().beginsWith('data:image/')"
          },
          "by": { ".validate": "newData.isString()" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "qna": {
      ".read": true,

      "$id": {
        ".write": "auth != null && auth.uid === 'CGaaFhrs59RrtNai2rYEBtdkbDD3' || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['body', 'at'])",

        "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "body": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000" },
        "at":   { ".validate": "newData.isNumber()" },

        "answer": {
          ".write": "auth != null && auth.uid === 'CGaaFhrs59RrtNai2rYEBtdkbDD3'",
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "answeredAt": {
          ".write": "auth != null && auth.uid === 'CGaaFhrs59RrtNai2rYEBtdkbDD3'",
          ".validate": "newData.isNumber()"
        },

        "$other": { ".validate": false }
      }
    }
  }
}
